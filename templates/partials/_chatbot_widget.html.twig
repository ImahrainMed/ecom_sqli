<div class="chatbot-widget" data-controller="chatbot">
    <button type="button" class="chatbot-widget__toggle" data-action="click->chatbot#toggle" aria-label="Ouvrir le chat">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
    </button>

    <div class="chatbot-widget__panel" data-chatbot-target="panel">
        <div class="chatbot-widget__header">
            <span>Assistant Ecom SQLI</span>
            <div class="chatbot-widget__header-actions">
                <button type="button" class="chatbot-widget__clear" data-action="click->chatbot#clear" aria-label="Vider la conversation" title="Vider la conversation">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"/>
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                    </svg>
                </button>
                <button type="button" class="chatbot-widget__close" data-action="click->chatbot#toggle" aria-label="Fermer le chat">&times;</button>
            </div>
        </div>

        <div class="chatbot-widget__messages" data-chatbot-target="messages">
            <div class="chatbot-message chatbot-message--bot">
                <div class="chatbot-message__bubble">Bonjour ! Je peux vous aider à trouver des produits. Que cherchez-vous ?</div>
            </div>
        </div>

        <div class="chatbot-typing" data-chatbot-target="typing" hidden>
            En train d'écrire
            <span class="chatbot-typing__dots"><span></span><span></span><span></span></span>
        </div>

        <form class="chatbot-widget__form" data-action="submit->chatbot#send">
            <input type="text" class="chatbot-widget__input" data-chatbot-target="input" placeholder="Écrivez un message…" autocomplete="off">
            <button type="submit" class="chatbot-widget__send" aria-label="Envoyer">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                    <path d="M2 21l21-9L2 3v7l15 2-15 2z"/>
                </svg>
            </button>
        </form>
    </div>
</div>
