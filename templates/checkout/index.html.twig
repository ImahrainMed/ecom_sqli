{% extends 'base.html.twig' %}

{% block title %}Checkout | Ecom SQLI{% endblock %}

{% block body %}
    <section class="checkout-page">
        <div class="checkout-card">
            <div class="checkout-card__header">
                <h1>Checkout</h1>
                <p>Review your order and enter your shipping address.</p>
            </div>

            <div class="checkout-summary">
                <h2>Order summary</h2>

                <table class="checkout-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Qty</th>
                            <th>Unit price</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in items %}
                            <tr>
                                <td>{{ item.product.name }}</td>
                                <td>{{ item.quantity }}</td>
                                <td>{{ item.product.price|number_format(2, '.', ' ') }} MAD</td>
                                <td>{{ item.subtotal|number_format(2, '.', ' ') }} MAD</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

                <div class="checkout-total">
                    <span>Total</span>
                    <strong>{{ total|number_format(2, '.', ' ') }} MAD</strong>
                </div>
            </div>

            <form method="post" class="checkout-form">
                <h2>Shipping address</h2>

                <div class="form-group">
                    <label for="street">Street</label>
                    <input
                        type="text"
                        id="street"
                        name="street"
                        class="form-control"
                        value="{{ formData.street ?? '' }}"
                        required
                    >
                    {% if errors.street is defined %}
                        <p class="form-error">{{ errors.street }}</p>
                    {% endif %}
                </div>

                <div class="form-group">
                    <label for="city">City</label>
                    <input
                        type="text"
                        id="city"
                        name="city"
                        class="form-control"
                        value="{{ formData.city ?? '' }}"
                        required
                    >
                    {% if errors.city is defined %}
                        <p class="form-error">{{ errors.city }}</p>
                    {% endif %}
                </div>

                <div class="form-group">
                    <label for="postalCode">Postal code</label>
                    <input
                        type="text"
                        id="postalCode"
                        name="postalCode"
                        class="form-control"
                        value="{{ formData.postalCode ?? '' }}"
                        required
                    >
                    {% if errors.postalCode is defined %}
                        <p class="form-error">{{ errors.postalCode }}</p>
                    {% endif %}
                </div>

                <div class="form-group">
                    <label for="country">Country</label>
                    <input
                        type="text"
                        id="country"
                        name="country"
                        class="form-control"
                        value="{{ formData.country ?? '' }}"
                        required
                    >
                    {% if errors.country is defined %}
                        <p class="form-error">{{ errors.country }}</p>
                    {% endif %}
                </div>

                <button type="submit" class="btn btn-primary checkout-submit">
                    Place order
                </button>
            </form>
        </div>
    </section>
{% endblock %}